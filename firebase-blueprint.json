{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with tenant memberships and current active workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "Profile avatar URL" },
        "currentTenantId": { "type": "string", "description": "Active tenant workspace ID" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "email", "currentTenantId", "createdAt"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Multi-tenant organization or clinic workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Tenant unique ID" },
        "name": { "type": "string", "description": "Workspace name" },
        "ownerId": { "type": "string", "description": "User ID of tenant owner" },
        "members": { "type": "object", "description": "Map of user IDs to their role (owner, admin, member)" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "name", "ownerId", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Multi-step prompt blog generation project belonging to a tenant or user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Project ID" },
        "tenantId": { "type": "string", "description": "Owning tenant ID" },
        "userId": { "type": "string", "description": "Owner User ID" },
        "name": { "type": "string", "description": "Project name" },
        "description": { "type": "string", "description": "Project summary" },
        "targetAudience": { "type": "string", "description": "Audience" },
        "tone": { "type": "string", "description": "Editorial tone" },
        "targetWordCount": { "type": "number", "description": "Word count target" },
        "tags": { "type": "array", "description": "Category tags" },
        "steps": { "type": "array", "description": "Pipeline steps" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "name", "steps", "createdAt", "updatedAt"]
    },
    "Session": {
      "title": "Session",
      "description": "Active generation session belonging to a project",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Session ID" },
        "tenantId": { "type": "string", "description": "Owning tenant ID" },
        "userId": { "type": "string", "description": "Owner User ID" },
        "projectId": { "type": "string", "description": "Associated project ID" },
        "userInput": { "type": "string", "description": "Topic or source input" },
        "status": { "type": "string", "description": "Session status" },
        "currentStepIndex": { "type": "number", "description": "Current active step index" },
        "stepOutputs": { "type": "object", "description": "Output records per step" },
        "finalBlog": { "type": "string", "description": "Delivered final blog" },
        "totalTokens": { "type": "object", "description": "Token usage metrics" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "projectId", "createdAt", "updatedAt"]
    },
    "UsageRecord": {
      "title": "UsageRecord",
      "description": "Daily API token consumption log per project session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Record ID" },
        "tenantId": { "type": "string", "description": "Owning tenant ID" },
        "userId": { "type": "string", "description": "User ID" },
        "projectId": { "type": "string", "description": "Project ID" },
        "projectName": { "type": "string", "description": "Project name" },
        "date": { "type": "string", "description": "Date YYYY-MM-DD" },
        "timestamp": { "type": "string", "description": "ISO timestamp" },
        "promptTokens": { "type": "number", "description": "Input prompt tokens" },
        "candidatesTokens": { "type": "number", "description": "Output tokens" },
        "totalTokens": { "type": "number", "description": "Total tokens" },
        "estimatedCostUsd": { "type": "number", "description": "Cost in USD" },
        "sessionTopic": { "type": "string", "description": "Topic" },
        "stepsCompleted": { "type": "number", "description": "Steps completed" }
      },
      "required": ["id", "projectId", "projectName", "date", "timestamp", "totalTokens"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profiles indexed by Auth UID"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "Project" },
      "description": "User's individual projects and prompt pipelines saved by User ID"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "Session" },
      "description": "User's generation sessions and outputs saved by User ID"
    },
    "/users/{userId}/usageRecords/{recordId}": {
      "schema": { "$ref": "UsageRecord" },
      "description": "User's API token consumption logs saved by User ID"
    },
    "/tenants/{tenantId}": {
      "schema": { "$ref": "Tenant" },
      "description": "Workspaces and organizations"
    },
    "/tenants/{tenantId}/projects/{projectId}": {
      "schema": { "$ref": "Project" },
      "description": "Projects scoped to tenant"
    },
    "/tenants/{tenantId}/sessions/{sessionId}": {
      "schema": { "$ref": "Session" },
      "description": "Generation sessions scoped to tenant"
    },
    "/tenants/{tenantId}/usageRecords/{recordId}": {
      "schema": { "$ref": "UsageRecord" },
      "description": "API usage records scoped to tenant"
    }
  }
}
